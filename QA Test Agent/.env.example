# --- LLM provider (agents/services/llm_provider.py) ---
# This is only the server-wide DEFAULT - each run can override provider +
# model from the UI's "LLM Provider" / "Model" fields.
# Supported providers: gemini | openai | azure_openai | grok | groq | sarvam
#
# NOTE: "grok" (xAI's chatbot, console.x.ai) and "groq" (the fast-inference
# company, console.groq.com) are two different providers with similar
# names - both are implemented here as separate options, don't mix them up.
LLM_PROVIDER=gemini
MODEL=gemini-2.5-flash
# Gemini - https://aistudio.google.com/apikey
# Models (verified via ai.google.dev/gemini-api/docs/models): gemini-2.5-flash,
# gemini-2.5-pro, gemini-2.5-flash-lite (cheapest); newer gemini-3.x models
# also exist - check the docs link above for the current list.
GEMINI_API_KEY=
# OpenAI - https://platform.openai.com/api-keys
# Models (verified via platform pricing page): gpt-4.1, gpt-4.1-mini,
# gpt-4o, gpt-4o-mini (cheap/legacy); gpt-5, gpt-5-mini, gpt-5.6-terra and
# newer also exist - check platform.openai.com/docs/pricing for the list.
OPENAI_API_KEY=
# Azure OpenAI - the "model" value here (and per-run in the UI) must be the
# DEPLOYMENT NAME you created in Azure OpenAI Studio, not a raw model id -
# Azure requires you to deploy a base model under a name of your choosing.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
# xAI Grok - https://console.x.ai (OpenAI-compatible API)
# Models (verified via docs.x.ai/docs/models): grok-4.6 (latest), grok-4.5, grok-4.3
GROK_API_KEY=
# Groq (fast-inference hardware, console.groq.com - NOT the same as xAI's
# Grok above). OpenAI-compatible API (verified via console.groq.com/docs/openai).
# Models (verified via console.groq.com/docs/models): openai/gpt-oss-120b and
# openai/gpt-oss-20b (recommended - native JSON-schema structured output
# support), llama-3.3-70b-versatile (best-effort JSON mode only)
GROQ_API_KEY=
# Sarvam AI - https://dashboard.sarvam.ai
# Models (verified via docs.sarvam.ai): sarvam-105b (128K context, default
# here), sarvam-105b-conversations (32K, for real-time chat/voice)
SARVAM_API_KEY=

# --- Storage ---
DATABASE_URL=sqlite:///./aivar.db
ARTIFACTS_ROOT=../runs

# --- Security / domain policy ---
# Comma-separated allowlist. Leave empty to allow any public domain not in BLOCKED_DOMAINS.
ALLOWED_DOMAINS=
BLOCKED_DOMAINS=localhost,127.0.0.1,0.0.0.0,169.254.169.254,metadata.google.internal
# Fernet key (44-char urlsafe base64). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEY=

# --- Discovery bounds ---
MAX_PAGES=15
MAX_DEPTH=3
MAX_ACTIONS_PER_PAGE=25
MAX_DISCOVERY_TIME_SECONDS=180

# --- Run limits ---
MAX_PLAN_REVISIONS=2
DEFAULT_MAX_HEALING_ATTEMPTS=3
AGENT_TIMEOUT_SECONDS=120
MAX_RETRIES=2

# --- CORS ---
CORS_ORIGINS=http://localhost:5173

# --- Observability: LangSmith (optional) ---
# Get a key at https://smith.langchain.com. When unset, tracing is simply
# disabled - the app runs identically, just without external traces.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=aivar-autonomous-testing
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
